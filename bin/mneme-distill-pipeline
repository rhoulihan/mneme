#!/usr/bin/env bash
# The background distiller: prepare -> headless agent -> ingest (spec §7.2).
# Runs detached from the session; failures surface only in the caller's log.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
TRANSCRIPT="${1:-}"
export MNEME_DISTILLING=1

# The prepare bundle is kept on disk and handed back to ingest as the snapshot of
# flags this run distilled: the session goes on flagging while the agent thinks
# (minutes, and PreCompact fires mid-session), and only these records may be
# cleared — anything appended after this point has never reached a distiller.
BUNDLE="$(mktemp "${TMPDIR:-/tmp}/mneme-distill.XXXXXX")"
trap 'rm -f "$BUNDLE"' EXIT

"$ROOT/bin/mneme" distill prepare --transcript "$TRANSCRIPT" >"$BUNDLE"
PROMPT="$(python3 -c 'import json, sys; print(json.load(open(sys.argv[1]))["prompt"])' "$BUNDLE")"

"${MNEME_CLAUDE_BIN:-claude}" -p "$PROMPT" \
  --output-format json \
  --max-turns 30 \
  --model "${MNEME_DISTILL_MODEL:-sonnet}" \
  --allowedTools "Read,Grep,Glob" \
  | python3 -c 'import json, sys; print(json.load(sys.stdin)["result"])' \
  | "$ROOT/bin/mneme" distill ingest - --clear-flags --flags-snapshot "$BUNDLE" \
      --source "session:$(basename "$TRANSCRIPT" 2>/dev/null || echo unknown)"
